{
  "manifest_version": 3,
  "name": "Quick Comment Analyzer",
  "version": "1.1.0",
  "description": "Right-click selected text to analyze its sentiment and get a star rating.",
  "permissions": [
    "contextMenus",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://YOUR-RENDER-SERVICE.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}